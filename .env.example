# Supabase — sign-in and saved scenarios.
#
# Both are public values, safe to expose in the browser: the anon key only
# grants what your row-level security policies allow. Set them in Cloudflare
# under Workers & Pages -> your Worker -> Settings -> Variables, as plaintext
# build-time variables, because NEXT_PUBLIC_* is inlined at build time.
#
# Leave them unset and the site builds and deploys exactly as it does today,
# with the sign-in UI showing a "not configured" state.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
